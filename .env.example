# ---- Database (PostgreSQL) ----
# Local dev via docker-compose: postgresql://colorflow:colorflow@localhost:5432/colorflow
DATABASE_URL=

# ---- Auth ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ---- Ad provider ----
# "demo" simulates a 30-second rewarded ad for development.
# Replace with a real compatible provider (see README) for production.
AD_PROVIDER=demo

# ---- Optional: Redis (rate limiting / caching). Falls back to in-memory when empty. ----
REDIS_URL=

# ---- Rate limiting ----
RATE_LIMIT_SECRET=
# Set to "false" when testing the production build over plain http://localhost
COOKIE_SECURE=

# ---- Public site URL (SEO canonical / sitemap) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
